# Environment Configuration for RAG Eyeshades Chatbot

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_MAX_TOKENS=500

# Shopify Configuration
SHOPIFY_SHOP_URL=your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token_here
SHOPIFY_API_VERSION=2023-10

# Google Sheets Configuration
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEETS_PRODUCT_SHEET_ID=your_product_sheet_id
GOOGLE_SHEETS_FAQ_SHEET_ID=your_faq_sheet_id
GOOGLE_SHEETS_KNOWLEDGE_SHEET_ID=your_knowledge_sheet_id

# ChromaDB Configuration
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_PRODUCTS=eyewear_products
CHROMA_COLLECTION_KNOWLEDGE=eyewear_knowledge
CHROMA_COLLECTION_FAQ=eyewear_faq

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_SECRET_KEY=your_secret_key_for_jwt_here
API_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/chatbot.log

# RAG Configuration
MAX_CONTEXT_LENGTH=4000
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7
CONVERSATION_MEMORY_LENGTH=10

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Development/Production Mode
ENVIRONMENT=development
DEBUG=true

# Store Information
STORE_NAME="Your Store Name"
STORE_WEBSITE="https://your-store-website.com"
STORE_EMAIL="support@your-store.com"
STORE_PHONE="+1-555-123-4567"
STORE_ADDRESS="Your Store Address"
STORE_BUSINESS_HOURS="Your Business Hours"
STORE_DESCRIPTION="Your store description"
STORE_SPECIALTIES="Your specialties"
STORE_RETURN_POLICY="Your return policy"
STORE_SHIPPING_INFO="Your shipping information"
