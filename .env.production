# Production Environment Configuration for Railway
# Copy these variables to your Railway environment

# OpenAI Configuration (REQUIRED)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_MAX_TOKENS=500

# Shopify Configuration (REQUIRED)
SHOPIFY_SHOP_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your-access-token-here
SHOPIFY_API_VERSION=2023-10

# Database Configuration
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_PRODUCTS=eyewear_products
CHROMA_COLLECTION_KNOWLEDGE=eyewear_knowledge
CHROMA_COLLECTION_FAQ=eyewear_faq

# API Configuration (PORT is automatically set by Railway)
API_HOST=0.0.0.0
API_RELOAD=false
API_SECRET_KEY=your-production-secret-key-here
API_CORS_ORIGINS=["https://your-domain.com", "https://eyeshades.pk"]

# Logging
LOG_LEVEL=INFO

# Optional: Google Sheets Configuration
GOOGLE_SHEETS_PRODUCT_SHEET_ID=your-sheet-id-here
GOOGLE_SHEETS_FAQ_SHEET_ID=your-faq-sheet-id-here
GOOGLE_SHEETS_KNOWLEDGE_SHEET_ID=your-knowledge-sheet-id-here

# Store Information
STORE_NAME=Eyeshades
STORE_WEBSITE=https://eyeshades.pk
STORE_EMAIL=info@eyeshades.pk
STORE_PHONE=+92-XXX-XXXXXXX
STORE_ADDRESS=Your Address Here
STORE_BUSINESS_HOURS=9 AM - 6 PM, Monday to Saturday
